# Datasets: the full data is ~24 GB (CICIoT2023 has 60 files over GitHub's 100 MB limit), so only the
# inventory, samples, the MalMem CSV (19 MB) and dataset documentation are tracked. See Datasets/README.md.
Datasets/*
!Datasets/README.md
!Datasets/inventory/
!Datasets/samples/
!Datasets/cicmalmem22/
!Datasets/ciciot23/
Datasets/ciciot23/*
!Datasets/ciciot23/CSV/
Datasets/ciciot23/CSV/*
!Datasets/ciciot23/CSV/README.pdf

# Derived features cached by the scripts (regenerated on demand)
Probabilistic_Anomaly_Scoring/cache/
# BODMAS triage lists carry per-file feature values; its terms forbid sharing the data
Probabilistic_Anomaly_Scoring/results/triage/bodmas_*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Office lock / temp files
~$*
*.tmp

# OS clutter
Thumbs.db
desktop.ini
.DS_Store
